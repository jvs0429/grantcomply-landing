# GrantComply landing — environment variables
# Copy to .env.local for local development.

# Public site URL used for canonical/OG tags and sitemap.
NEXT_PUBLIC_SITE_URL=https://grantcomply.app

# Resend — powers the Contact Sales form email notifications.
# Get a key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Optional overrides:
# Where lead emails are delivered (defaults to jonathanvstuart@gmail.com).
# CONTACT_TO=jonathanvstuart@gmail.com
# From address. Defaults to Resend's shared onboarding@resend.dev (test mode,
# delivers only to the Resend account owner). Set to a verified domain for prod.
# RESEND_FROM=GrantComply Leads <leads@grantcomply.app>
